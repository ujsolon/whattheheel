# MongoDB Atlas connection string (M0 free tier). Never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Separate database names per environment (architecture: never share dev/prod data).
MONGODB_DB_NAME=whattheheel_dev

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local dev only; Vercel infers this in Preview/Production.
NEXTAUTH_URL=http://localhost:3000

# Server-only authenticated selfie storage. Copy all three values from the
# Cloudinary API Keys page. The credentials must permit image upload and
# destroy; US2.2 stores assets with delivery type `authenticated` and deletes
# replaced/test assets with CDN invalidation. Never use NEXT_PUBLIC_ prefixes.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
