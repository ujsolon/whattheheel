# MongoDB Atlas connection string (M0 free tier). Never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Separate database names per environment (architecture: never share dev/prod data).
MONGODB_DB_NAME=whattheheel_dev

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local dev only; Vercel infers this in Preview/Production.
NEXTAUTH_URL=http://localhost:3000

# Server-only authenticated selfie storage. Copy all three values from the
# Cloudinary API Keys page. The credentials must permit image upload and
# destroy; US2.2 stores assets with delivery type `authenticated` and deletes
# replaced/test assets with CDN invalidation. Never use NEXT_PUBLIC_ prefixes.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Perfect Corp YouCam AI Shoes VTO. Get a free hackathon redeem code via
# yce.perfectcorp.com/ai-api. Server-only; never use NEXT_PUBLIC_ prefixes.
# Simple bearer auth (confirmed against the real API): Authorization: Bearer
# YOUCAM_API_KEY. The dashboard's "Secret key" (an RSA public key) is not
# needed for these v2.0 endpoints — see docs/ai-skin-analysis.md's
# "BearerAuthenticationV2" security scheme.
YOUCAM_API_KEY=<api-key>
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
