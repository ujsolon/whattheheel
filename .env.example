# MongoDB Atlas connection string (M0 free tier). Never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Separate database names per environment (architecture: never share dev/prod data).
MONGODB_DB_NAME=whattheheel_dev

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local dev only; Vercel infers this in Preview/Production.
NEXTAUTH_URL=http://localhost:3000
